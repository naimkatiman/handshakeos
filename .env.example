# OpenRouter key: https://openrouter.ai/keys
# Paid Gemma 4. Do not put the :free id here. That pool returns 429 when judges click.
OPENROUTER_API_KEY=
GEMMA_MODEL=google/gemma-4-26b-a4b-it
# Used only when OpenRouter fails. Gemma on the Gemini API often returns 500.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
